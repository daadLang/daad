
# مثال تشغيل للاستيراد (جميع الأسماء عربية)

# 1) Simple import
استورد مكتبة

# 2) Dotted import with alias
استورد مكتبة.فرعية باسم فرعية

# 3) Multiple imports with one aliased (both using مكتبة)
استورد مكتبة.فرعية, مكتبة ك مع_حزمة

# 4) Simple import with alias
استورد أدوات باسم الأدوات

# 5) From import
من مكتبة استورد قيمة_الحزمة

# 6) From import with mixed names
من مكتبة استورد قيمة_الحزمة باسم القيمة, فرعية

# 7) From dotted module star import
من مكتبة.فرعية استورد *

# 8) Relative import
من . استورد محلي

# 9) Relative star import
من . استورد *

# 10) Relative import from parent
من .. استورد اسم

# 11) Relative import from parent subdirectory with alias
من ..مكتبة.فرعية استورد جمع باسم جمع_بديل


