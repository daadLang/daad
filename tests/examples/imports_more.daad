# أمثلة إضافية للاستيراد
استورد أدوات
استورد أدوات.متقدم.أداة_خاصة
من مكتبة استورد *
من . استورد محلي

# استخدام الاستيراد النجمي
نتيجة1 = قيمة_الحزمة + فرعية.جمع(1, 2)
اطبع(نتيجة1)

# استخدام السلسلة المتداخلة
نتيجة2 = أدوات.متقدم.أداة_خاصة.احسب(2, 3)
اطبع(نتيجة2)

# استخدام الاستيراد النسبي من نفس المجلد
نتيجة3 = محلي.قيمة
اطبع(نتيجة3)
